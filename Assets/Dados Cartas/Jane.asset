  m_Script: {fileID: 11500000, guid: 26e66850dd5bd724086c9e58944df7b6, type: 3}
  m_Name: Jane
  m_EditorClassIdentifier: Assembly-CSharp::CartaData
  nomePersonagem: Jane Doe
  arteCarta: {fileID: -6934535487371555380, guid: c6ced7974cd2a614095a9c5dbc6b6322, type: 3}
  historiaLore: "Especialista em comportamento criminal e consultora da Seguran\xE7a
    P\xFAblica, Jane Doe \xE9 uma mestra em disfarces e infiltra\xE7\xE3o. Ela possui
    o p\xE9ssimo h\xE1bito de provocar os outros e pregar pe\xE7as, sendo uma imitadora
    t\xE3o habilidosa que faz todos questionarem qual \xE9 a \"verdadeira\" Jane.
    Embora pare\xE7a ter experi\xEAncia em absolutamente tudo, ela conta uma hist\xF3ria
    diferente a cada vez, mantendo sua verdadeira identidade um mist\xE9rio."
  habilidades: "Passiva: Tem 30% de chance de Confundir o inimigo que a atacar.\n\nHabilidade:
    Ap\xF3s 3 golpes, ataca 3 vezes seguidas a carta alvo. Esses ataques extras n\xE3o
    podem \"critar\" e n\xE3o contam para carregar a pr\xF3xima Habilidade ou Ult.\n\nUlt:
    Ap\xF3s 6 golpes, ataca 5 vezes seguidas as duas cartas inimigas. Estes golpes
    n\xE3o contam para carregar Habilidade/Ult, mas desta vez podem critar. Tamb\xE9m
    aumenta o Intelecto dela em +10 por meio turno."
  vidaBase: 100
  danoMinimo: 10
  danoMaximo: 20
